{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    // import.meta.env (VITE_API_BASE) 를 쓰기 위해
    "types": ["vite/client"]
  },
  "include": ["src", "vite.config.ts", "apps-in-toss.config.ts"]
}
